<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
    <testsuites>
        <testsuite name="integration">
            <file>tests/Integration/SeederTest.php</file>
            <file>tests/Integration/RepositoryTest.php</file>
            <file>tests/Integration/HomePageTest.php</file>
            <file>tests/Integration/CategoryServiceTest.php</file>
            <file>tests/Integration/CategoryPageTest.php</file>
            <file>tests/Integration/ArticleServiceTest.php</file>
            <file>tests/Integration/ArticlePageTest.php</file>
            <file>tests/Integration/ViewCountingTest.php</file>
            <file>tests/Functional/PagesTest.php</file>
        </testsuite>
    </testsuites>
    <source><include><directory>src</directory></include></source>
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="DB_HOST" value="db-test" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="blog_test" force="true"/>
        <env name="DB_USERNAME" value="blog_test" force="true"/>
        <env name="DB_PASSWORD" value="local-test-password" force="true"/>
        <env name="REDIS_HOST" value="redis-test" force="true"/>
        <env name="REDIS_PORT" value="6379" force="true"/>
        <env name="REDIS_DATABASE" value="0" force="true"/>
        <env name="VISITOR_SECRET" value="test-only-visitor-secret-at-least-thirty-two-bytes" force="true"/>
    </php>
</phpunit>
