{
  "name": "abelohost/editorial-blog",
  "description": "A small PHP MVC blog with MySQL and Smarty",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "smarty/smarty": "^5.8.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "ext-dom": "*",
    "ext-libxml": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "migrate": "php bin/migrate.php",
    "seed": "php bin/seed.php",
    "test:integration": "phpunit --configuration phpunit.integration.xml"
  }
}
